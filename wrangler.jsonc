{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-kelas-roman",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "web-kelas-content",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "web-kelas-images"
    }
  ],
  "observability": {
    "enabled": true
  }
}
